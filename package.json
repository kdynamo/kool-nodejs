{
  "name": "kool-nodejs",
  "version": "1.0.0",
  "description": "NodeJs Utilities and starter apps",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "scripts": {
    "build": "mkdir -p dist/esm dist/cjs && cp ./index.ts dist/esm/index.mjs && echo 'module.exports = require(\"../../dist/esm/index.mjs\")' > dist/cjs/index.cjs",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdynamo/kool-nodejs.git"
  },
  "keywords": [
    "nodeJs"
  ],
   "exports": {
      ".": {
        "import": "./dist/esm/index.mjs",
        "require": "./dist/cjs/index.cjs"
      }
  },
  "author": "Kevin A. Downing",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kdynamo/kool-nodejs/issues"
  },
  "homepage": "https://github.com/kdynamo/kool-nodejs#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
